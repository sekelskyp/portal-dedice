<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{subject}}</title>
    <style>
      body { font-family: Arial, sans-serif; } .content { max-width: 600px;
      margin: 0 auto; padding: 20px; } .footer { margin-top: 20px; font-size:
      12px; color: #666; text-align: center; }
    </style>
  </head>
  <body>
    <div class='content'>
      <h2>{{subject}}</h2>
      <div>
        {{{body}}}
        <!-- Injects the email-specific body here -->
      </div>
    </div>
    <div class='footer'>
      <p>Best Regards,</p>
      <p>Your Company Team</p>
      <p><a href='https://yourcompany.com'>Visit our website</a></p>
    </div>
  </body>
</html>